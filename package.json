{
  "name": "momo-confusables",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:similarity && npm run test:pronunciation && npm run test:pronunciation-quality && npm run test:notepad && npm run test:worker && npm run test:input && npm run test:pronunciation-audit && npm run test:g2p",
    "test:similarity": "node scripts/test-similarity.mjs",
    "test:pronunciation": "node scripts/test-pronunciation.mjs",
    "test:notepad": "node scripts/test-notepad.mjs",
    "test:worker": "node scripts/test-worker.mjs",
    "test:input": "node scripts/test-input.mjs",
    "test:pronunciation-audit": "node scripts/test-pronunciation-audit.mjs",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "build:pronunciation": "node scripts/build-pronunciation-data.mjs",
    "build": "python p0/build_dictionary_shards.py && python p0/build_dictionary_modules.py && npm run build:pronunciation && npm run typecheck && vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "build:g2p": "python scripts/build-g2p-data.py",
    "test:g2p": "node scripts/test-g2p.mjs && python scripts/test-g2p-build.py",
    "test:pronunciation-quality": "node scripts/test-pronunciation-quality.mjs",
    "evaluate:pronunciation": "node scripts/evaluate-pronunciation.mjs",
    "benchmark:pronunciation": "node scripts/benchmark-pronunciation.mjs",
    "benchmark:pronunciation-browser": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/benchmark-pronunciation-browser.mjs",
    "release:local": "npm run build && node scripts/package-local-release.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.32.0"
  }
}
